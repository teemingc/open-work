# Copy to .env and fill in what you need: cp .env.example .env
# Everything is optional for `pnpm dev`; features that need a missing value warn and stay off.

# Picks your Cloudflare account for wrangler, which otherwise asks when you have more than one.
CLOUDFLARE_ACCOUNT_ID=

# Open Collective OAuth app, for connecting your account. For local development, register the
# callback URL http://localhost:5317/auth/callback.
OC_CLIENT_ID=
OC_CLIENT_SECRET=

# Open Collective personal token (read-only is enough) for public data, such as collective stats,
# when the visitor has not connected: 100 requests a minute instead of 10.
OC_PERSONAL_TOKEN=

# Development only: act as connected to this Open Collective account slug, without connecting.
DEV_OPEN_COLLECTIVE_SLUG=

# Google OAuth client, to keep the work log in your Google Drive. For local development, register
# the redirect URI http://localhost:5317/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters, for example from: openssl rand -base64 32
BETTER_AUTH_SECRET=
