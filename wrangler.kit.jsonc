// What the SvelteKit adapter builds from: it writes its Worker to `.svelte-kit/cloudflare/worker`,
// which `worker.ts` wraps with a schedule. Deploys and bindings are in `wrangler.jsonc`.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "open-work",
	"compatibility_date": "2025-12-29",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS"
	}
}
