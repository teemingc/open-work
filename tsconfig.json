{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"checkJs": true,
		"paths": { "#lib/*": ["./src/lib/*"] },
		"types": ["$app/types"]
	},
	"include": [
		"src",
		"scripts",
		"worker-configuration.d.ts",
		"vite.config.ts",
		"playwright.config.ts",
		"eslint.config.js"
	]
}
