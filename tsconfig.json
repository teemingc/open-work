{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// worker-configuration.d.ts imports the built worker, so after a build TypeScript would
		// otherwise check the whole bundle. All of our own code is TypeScript.
		"checkJs": false,
		"types": ["$app/types", "./worker-configuration.d.ts"]
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts"]
}
