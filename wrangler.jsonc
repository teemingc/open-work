{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "open-work",
	"compatibility_date": "2025-12-29",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "openwork.ing",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	"kv_namespaces": [
		{
			"binding": "OC_CACHE",
			"id": "8045022794264a459303e9455b39ba04"
		}
	],
	"observability": {
		"enabled": true
	}
}
