{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "open-work",
	"compatibility_date": "2025-12-29",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "openwork.ing", "custom_domain": true }],
	// Kept on only to send the old address to the custom domain, in src/hooks.server.ts.
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	}
}
